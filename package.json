    "@expo/config-plugins": "^55.0.8",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@types/uuid": "^11.0.0",
    "detox": "^20.51.0",
    "detox-expo-helpers": "^0.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
