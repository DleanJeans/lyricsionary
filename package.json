{
  "name": "lyricsionaryapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:maestro": "maestro test .maestro",
    "emulator": "$ANDROID_HOME/emulator/emulator -netdelay none -netspeed full -no-snapshot-load -avd maestro_test",
    "test:detox": "detox test --configuration android.emu.release",
    "test:detox:debug": "detox test --configuration android.emu.debug --reuse",
    "test:detox:ios": "detox test --configuration ios.sim.debug",
    "test:detox:android": "detox test --configuration android.emu.release",
    "test:detox:build": "detox build --configuration android.emu.release",
    "test:detox:build:debug": "detox build --configuration android.emu.debug",
    "test:detox:build:ios": "detox build --configuration ios.sim.debug"
  },
  "dependencies": {
    "@expo/dom-webview": "^55.0.6",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/drawer": "^7.9.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~55.0.26",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-font": "~55.0.8",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-android-notification-listener": "^5.0.1",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.7.4",
    "rn-emoji-keyboard": "^1.7.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
