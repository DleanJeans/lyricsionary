{
  "expo": {
    "name": "Lyricsionary",
    "slug": "lyricsionary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F1A",
    "newArchEnabled": true,
    "scheme": "lyricsionary",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dleanjeans.lyricsionary"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#0F0F1A"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.dleanjeans.lyricsionary",
      "permissions": [
        "BIND_NOTIFICATION_LISTENER_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/126d9654-6b1d-4ff7-ae63-43d646dcb8a3"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "126d9654-6b1d-4ff7-ae63-43d646dcb8a3"
      }
    },
    "plugins": [
      "./plugins/withJVMMemory",
      "./plugins/withNotificationListener",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lyricsionary listens to you say words in the speaking quiz.",
          "speechRecognitionPermission": "Lyricsionary checks the words you say in the speaking quiz."
        }
      ]
    ],
    "owner": "dleanjeans"
  }
}
