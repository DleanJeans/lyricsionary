  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "patchedDependencies": {
      "rn-emoji-keyboard@1.7.0": "patches/rn-emoji-keyboard@1.7.0.patch"
    }
  }
